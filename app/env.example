# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_ENDPOINT=/api/products/?format=json

# Blog API. Only set this if the blog module is served from a different host
# than NEXT_PUBLIC_API_BASE_URL; otherwise leave it blank and the main host is used.
NEXT_PUBLIC_BLOG_API_BASE_URL=https://shop.serlesbake.in

# Website Configuration
NEXT_PUBLIC_SITE_URL=https://www.serlesbake.in
NEXT_PUBLIC_SITE_NAME=Serles Bake

# Contact Information
NEXT_PUBLIC_PHONE=+916383070725
NEXT_PUBLIC_EMAIL=serlesbake@gmail.com
NEXT_PUBLIC_ADDRESS=Tenkasi - Sengottai Main Road, Ilanji, Tenkasi, Tamil Nadu

# Social Media
NEXT_PUBLIC_INSTAGRAM=https://www.instagram.com/serles_bake
NEXT_PUBLIC_FACEBOOK=https://www.facebook.com/serlesbake
NEXT_PUBLIC_WHATSAPP=https://wa.me/916383070725

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# On-demand page refresh after CMS saves (app/api/revalidate). Same value as the
# backend project's REVALIDATE_SECRET. Generate a long random string.
REVALIDATE_SECRET=

# Run the storefront without Django (app/lib/storefront). SERVER-ONLY: never
# prefix with NEXT_PUBLIC_. Use Supabase's *transaction pooler* URL (port 6543),
# ideally a read-only role. Unset = read the Django API as before.
STOREFRONT_DATABASE_URL=
